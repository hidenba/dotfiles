[Desktop Entry]
# User override of /usr/share/applications/com.anthropic.Claude.desktop (claude-desktop).
# Adds --password-store=gnome-libsecret so Electron uses gnome-keyring for safeStorage.
# Without it, Chromium can't recognize XDG_CURRENT_DESKTOP=niri and falls back to
# backend=basic_text -> tokens can't persist -> OAuth session_stale_relogin ->
# "Code" folder selection fails. See CLAUDE.md.
# Rebased on upstream 1.40609.0 (2026-09-02); re-diff after package updates.
Name=Claude
Comment=Desktop application for Claude.ai
GenericName=AI Assistant
Keywords=AI;Chat;Assistant;Claude;Code;LLM;
Exec=/usr/bin/claude-desktop --password-store=gnome-libsecret %U
Icon=claude-desktop
Type=Application
StartupNotify=true
# Matches the Wayland app_id / X11 WM_CLASS Chromium derives from
# package.json desktopName, so docks group windows under this entry.
StartupWMClass=com.anthropic.Claude
# second-instance just focuses mainWindow; suppress GNOME's default "New Window" item
SingleMainWindow=true
Categories=Utility;Development;
MimeType=x-scheme-handler/claude;
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New Chat
Exec=/usr/bin/claude-desktop --password-store=gnome-libsecret "claude://claude.ai/new?surface=chat&source=desktop_action"

[Desktop Action NewCode]
Name=New Claude Code Session
Exec=/usr/bin/claude-desktop --password-store=gnome-libsecret "claude://code/new?source=desktop_action"

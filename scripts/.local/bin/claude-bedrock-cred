#!/usr/bin/env bash
# claude-bedrock-cred — Claude Desktop (3Pモード) 用の Bedrock 認証ヘルパー
#
# Claude Desktop は /etc/claude-desktop/managed-settings.json の
# inferenceCredentialHelper からこのスクリプトを引数なしで実行し、stdout を
# トリムしてベアラートークンとして使う (終了コードは 0 必須、stderr は無視される)。
#
# トークン本体は Git 管理外の秘密ファイルにしか置かない。managed-settings.json は
# /etc 配下で他ユーザーからも読めるため、そこに直接書くのを避けるためのヘルパー。
#
# 参照: https://claude.com/docs/third-party/claude-desktop/configuration

set -euo pipefail

SECRET_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/60-bedrock-secret.conf"

if [ ! -r "$SECRET_FILE" ]; then
    echo "claude-bedrock-cred: cannot read $SECRET_FILE" >&2
    exit 1
fi

# 形式: AWS_BEARER_TOKEN_BEDROCK=<キー>  (systemd environment.d 形式)
token=$(sed -n 's/^[[:space:]]*AWS_BEARER_TOKEN_BEDROCK=//p' "$SECRET_FILE" | tail -n1)
token=${token%$'\r'}
token=${token#\"} ; token=${token%\"}
token=${token#\'} ; token=${token%\'}

if [ -z "$token" ]; then
    echo "claude-bedrock-cred: AWS_BEARER_TOKEN_BEDROCK not found in $SECRET_FILE" >&2
    exit 1
fi

printf '%s' "$token"
